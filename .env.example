# Poorman's Marriage — environment variables
# Copy to .env and fill in.

# JWT signing secret — generate a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string

# Where SQLite DB and receipt images live
DATA_DIR=./data

# Backend port
PORT=3100

# Default currency (used for new households)
DEFAULT_CURRENCY=NOK

# Tesseract languages (space-separated: nor+eng, eng, etc.)
OCR_LANGS=nor+eng
